<?xml version="1.0" encoding="utf-8"?>
<!-- fitsSystemWindows replaces a view's own padding, so it sits on the outer ScrollView. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_instructions"
            android:textSize="16sp" />

        <Button
            android:id="@+id/sync_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/sync_from_clipboard" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/player_name_label"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/player_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/player_name_hint"
            android:importantForAutofill="no"
            android:inputType="textPersonName"
            android:maxLength="15"
            android:singleLine="true" />

        <Button
            android:id="@+id/save_name_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/save" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:alpha="0.6"
            android:text="@string/credits"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
