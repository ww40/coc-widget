<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <size android:width="20dp" android:height="20dp" />
                    <solid android:color="#FF1F1F3A" />
                </shape>
            </item>
            <item android:drawable="@drawable/ic_moon" android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp" />
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <size android:width="20dp" android:height="20dp" />
                    <solid android:color="#FFF5C542" />
                </shape>
            </item>
            <item android:drawable="@drawable/ic_sun" android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp" />
        </layer-list>
    </item>
</selector>
